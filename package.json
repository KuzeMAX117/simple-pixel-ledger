{
  "name": "trace-wallet",
  "version": "1.0.0",
  "description": "Obsidian 月历可视化记账插件：回溯历史收支流水，本地存储，侧边栏/主面板 Tab 打开，快速记账，日记代码块嵌入收支记录。",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": ["obsidian", "plugin", "trace-wallet", "wallet", "ledger", "finance", "expense"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "builtin-modules": "^3.2.0",
    "esbuild": "0.17.3",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  }
}
