{
  "name": "pixel-ledger",
  "version": "1.0.0",
  "description": "Obsidian 收支记账插件：日记内嵌收支面板 + 独立月历财务统计视图，像素风数字字体。",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": ["obsidian", "plugin", "ledger", "finance", "expense"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "builtin-modules": "^3.2.0",
    "esbuild": "0.17.3",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  }
}
